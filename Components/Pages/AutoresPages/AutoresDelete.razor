@page "/Autores/Delete/{IdAutor:int}"

@rendermode InteractiveServer

@inject AutoresServices AutoresServices
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Eliminar Autor</PageTitle>

@if (Autor != null)
{

    <div class="container">
        <div class="card shadow-lg ">
            <div class="card-header d-flex align-items-center" style="height: 54px;">
                <h5 class="mb-0">
                    Eliminar Autor
                </h5>
            </div>

            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <label class="form-label">
                        <strong>Id</strong>
                    </label>
                    <InputNumber @bind-Value="Autor.IdAutor" disabled class="form-control"></InputNumber>

                    <div class="d-flex flex-column gap-2">
                        <label class="form-label">
                            <strong>Nombres</strong>
                        </label>
                        <InputText @bind-Value="Autor.Nombres" disabled class="form-control"></InputText>

                        <label class="form-label">
                            <strong>Nacionalidad</strong>
                        </label>
                        <InputText @bind-Value="Autor.Nacionalidad" disabled class="form-control"></InputText>

                        <label class="form-label">
                            <strong>Fecha Nacimiento</strong>
                        </label>
                        <InputDate @bind-Value="Autor.FechaNacimiento" disabled class="form-control"></InputDate>

                        <label class="form-label">
                            <strong>Sueldo</strong>
                        </label>
                        <InputNumber @bind-Value="Autor.Sueldo" disabled class="form-control"></InputNumber>
                    </div>
                </div>
    
            </div>

            <div class="card-footer d-flex gap-3">
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalEliminar">Eliminar</button>
                <a href="/Autores/Index" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>
    </div>
}
else
{
    <p>Autor no encontrado</p>
}

@*Modal*@
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="tituloModalEliminar" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalEliminar">Modal title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar este autor?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>
                <button @onclick="Eliminar" type="button" class="btn btn-danger">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public int IdAutor { get; set; }
    public Autores? Autor { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Autor = await AutoresServices.Buscar(IdAutor);
    }

    public async Task Eliminar()
    {

        if (await AutoresServices.Eliminar(IdAutor))
        {
            ToastService.ShowSuccess("Autor eliminado correctamente!", "Eliminar Autor");
            NavigationManager.NavigateTo("/Autores/Index");
            return;
        }

        else
        {
            ToastService.ShowWarning("No se ha podido eliminar el Autor correctamente", "Eliminar Autor");
            return;
        }
    }
}
