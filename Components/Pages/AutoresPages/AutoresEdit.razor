@page "/Autores/Edit/{IdAutor:int}"

@rendermode InteractiveServer

@inject AutoresServices AutoresServices
@inject ToastService ToastService
@inject NavigationManager NavigationManager

@if (Autor != null) {

<EditForm Model="Autor" OnValidSubmit="Guardar">

    <DataAnnotationsValidator></DataAnnotationsValidator>

<div class="container">
    <div class="card shadow-lg ">
        <div class="card-header d-flex align-items-center" style="height: 54px;">
            <h5 class="mb-0">
                Editar Autor
            </h5>
        </div>

        <div class="card-body">
            <div class="d-flex flex-column gap-2">
                <label class="form-label">
                    <strong>Nombres</strong>
                </label>
                <InputText @bind-Value="Autor.Nombres" class="form-control"></InputText >
                <ValidationMessage For="@(() => Autor.Nombres)"></ValidationMessage>

                <label class="form-label">
                    <strong>Nacionalidad</strong>
                </label>
                <InputText @bind-Value="Autor.Nacionalidad" class="form-control"></InputText >

                <label class="form-label">
                    <strong>Fecha Nacimiento</strong>
                </label>
                <InputDate @bind-Value="Autor.FechaNacimiento" class="form-control"></InputDate >

                <label class="form-label">
                    <strong>Sueldo</strong>
                </label>
                <InputNumber @bind-Value="Autor.Sueldo" class="form-control"></InputNumber>

            </div>
        </div>

        <div class="card-footer d-flex gap-3">
            <button type="submit" class="btn btn-primary">Editar</button>
            <a href="/Autores/Delete/@IdAutor" class="btn btn-danger">Eliminar</a>
            <a href="/Autores/Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </div>
</div>

</EditForm>
}
else
{
    <p>Autor no encontrado</p>
}
@code {

    [Parameter]
    public int IdAutor { get; set; } 
    public Autores? Autor { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Autor = await AutoresServices.Buscar(IdAutor);
    }

    public async Task Guardar()
    {

        if (Autor == null)
        {
            ToastService.ShowWarning("Este Autor no se encuentra.", "Editar Autor");
        }

        if (await AutoresServices.Guardar(Autor))
        {
            ToastService.ShowSuccess("Autor editado correctamente!", "Editar Autor");
            NavigationManager.NavigateTo("/Autores/Index");
            return;
        }

        else
        {
            ToastService.ShowWarning("No se ha podido editar el Autor correctamente", "Editar Autor");
            return;
        }
    }
}
