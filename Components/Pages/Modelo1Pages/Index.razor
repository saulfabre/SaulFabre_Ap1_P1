@page "/Autores/Index"
@using Microsoft.AspNetCore.Components.QuickGrid

@rendermode InteractiveServer

@inject AutoresServices AutoresServices
@inject ToastService ToastService

<PageTitle>Index</PageTitle>

<div class="container">

    <div class="card shadow-lg">

        @*Encabezado*@
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 54px;">
            <h5 class="mb-0">Consulta Autores</h5>
            <a href="/Autores/Create" class="btn btn-primary">Crear</a>
        </div>

        <div class="card-body">

            @*Filtrar*@
            <div class="d-flex gap-4">
                <div class="d-flex flex-column">
                    <label class="form-label">
                        <strong>Filtrar por</strong>
                    </label>

                    <select class="form-select" @bind="Filtro">
                        <option value="" selected disabled>Elige una opción</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Nacionalidad">Nacionalidad</option>
                        <option value="Sueldo">Sueldo</option>
                    </select>
                </div>

                @*Búsqueda*@
                <div class="d-flex flex-column">
                    <label class="form-label">
                        <strong>Búsqueda</strong>
                    </label>

                    <div class="d-flex gap-2" <input @bind="ValorFiltro" class="form-control" type="text"
                                                         placeholder="Buscar..." />
                        <button @onclick="Buscar" class="btn btn-outline-primary bi bi-search"></button>
                    </div>
                </div>
            </div>

            @*QuickGrid*@
            <QuickGrid Items="@Autores.AsQueryable()" Class="table table-bordered mt-3 align-center align-middle">
                <PropertyColumn Property="@(a => a.IdAutor)" Title="ID"></PropertyColumn>
                <PropertyColumn Property="@(a => a.Nombres)" Title="Nombres"></PropertyColumn>
                <PropertyColumn Property="@(a => a.Nacionalidad)" Title="Nacionalidad"></PropertyColumn>
                <PropertyColumn Property="@(a => a.FechaNacimiento)" Title="Fecha Nacimiento"></PropertyColumn>
                <PropertyColumn Property="@(a => a.Sueldo)" Title="Sueldo"></PropertyColumn>

                <TemplateColumn Title="Acciones">
                    <a href="/Autores/Edit/@context.IdAutor" class="btn btn-warning">Editar</a>
                    
                </TemplateColumn>
            </QuickGrid>
        </div>

        @*Footer*@
        <div class="card-footer d-flex justify-content-between">
            <p class="mb-0">
                <strong>Cantidad: </strong> @Autores.Count()
            </p>
            <p class="mb-0">
                <strong>Total: </strong> @Autores.Sum(a => a.Sueldo)
            </p>
        </div>

    </div>
</div>
@*Modal*@

@code {

    public string Filtro = "";
    public string ValorFiltro = "";

    public List<Autores> Autores { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Autores = await AutoresServices.GetList(a => true);
    }

    public async Task Buscar()
    {
        if (Filtro != "")
        {
            if (Filtro == "Nombres")
            {
                Autores = await AutoresServices.GetList(a => a.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Nacionalidad")
            {
                Autores = await AutoresServices.GetList(a => a.Nacionalidad.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "FechaNacimiento" && DateOnly.TryParse(ValorFiltro, out DateOnly fechaNacimiento))
            {
                Autores = await AutoresServices.GetList(a => a.FechaNacimiento == fechaNacimiento);
            }

            else if (Filtro == "Sueldo" && decimal.TryParse(ValorFiltro, out decimal sueldo))
            {
                Autores = await AutoresServices.GetList(a => a.Sueldo == sueldo);
            }
        }
        else
        {
            Autores = await AutoresServices.GetList(a => true);
        }
    }
}
