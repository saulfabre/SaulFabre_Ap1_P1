@page "/Modelo1/Index"
@using SaulFabre_Ap1_P1.Extensors

@rendermode InteractiveServer

@inject Modelo1Services Modelo1Services
@inject ToastService ToastService

<PageTitle>Index</PageTitle>

<div class="container">

    <div class="card shadow-lg">

        @*Encabezado*@
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 54px;">
            <h5 class="mb-0">Consulta Modelo1</h5>
            <a href="" class="btn btn-primary">Crear</a>
        </div>

        <div class="card-body">

            @*Filtrar*@
            <div class="d-flex gap-4">
                <div class="d-flex flex-column">
                    <label class="form-label">
                        <strong>Filtrar por</strong>
                    </label>

                    <select class="form-select" @bind="Filtro">
                        <option value="" selected disabled>Elige una opción</option>
                        <option value="Id">Filtro</option>
                        <option value="">Filtro</option>
                    </select>
                </div>

                @*Búsqueda*@
                <div class="d-flex flex-column">
                    <label class="form-label">
                        <strong>Búsqueda</strong>
                    </label>

                    <div class="d-flex gap-2" 
                        <input @bind="ValorFiltro" class="form-control" type="text" placeholder="Buscar..." />
                        <button @onclick="Buscar" class="btn btn-outline-primary bi bi-search"></button>
                    </div>
                </div>
            </div>

            @*QuickGrid*@
        </div>
            @*Footer*@
    </div>
</div>
            @*Modal*@

@code {

    public string Filtro = "";
    public string ValorFiltro = "";

    public async Task Buscar()
    {
        
    }
}